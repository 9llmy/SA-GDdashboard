# =====================================================
# Saudi Jobs & Education Dashboard — environment sample
# =====================================================
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# .env.local is gitignored. This file (.env.example) IS
# committed, so it must contain placeholders only.
# =====================================================

# ---- PUBLIC (safe: bundled into the browser JS) ----
# The NEXT_PUBLIC_ prefix exposes the value to the client.
# Only use it for values that are safe for anyone to read.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LANG=ar

# ---- SERVER-ONLY (secret: never prefixed with NEXT_PUBLIC_) ----
# Readable only inside API routes / server components.
# Uncomment when you actually need them.

# OPEN_DATA_API_KEY=your_key_here
# ANALYTICS_WRITE_KEY=your_key_here
